{
  "name": "@flowdown/reactive",
  "version": "0.1.0",
  "description": "Headless reactive primitives for Flowdown streaming state.",
  "keywords": [
    "headless",
    "llm",
    "markdown",
    "reactive",
    "rxjs",
    "streaming"
  ],
  "homepage": "https://github.com/hexmora/flowdown/tree/main/packages/reactive#readme",
  "bugs": {
    "url": "https://github.com/hexmora/flowdown/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmora/flowdown.git",
    "directory": "packages/reactive"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./jsx-runtime": {
        "types": "./dist/jsx-runtime.d.ts",
        "import": "./dist/jsx-runtime.js",
        "require": "./dist/jsx-runtime.cjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flowdown/utils": "workspace:*",
    "lodash-es": "catalog:",
    "rxjs": "catalog:",
    "shallow-equal": "catalog:"
  },
  "devDependencies": {
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
