{
  "name": "@flowdown/preset-plugins",
  "version": "0.1.0",
  "description": "Headless preset remark, rehype, and repair plugins for Flowdown.",
  "keywords": [
    "headless",
    "markdown",
    "plugins",
    "rehype",
    "remark",
    "unified"
  ],
  "homepage": "https://github.com/hexmora/flowdown/tree/main/packages/preset-plugins#readme",
  "bugs": {
    "url": "https://github.com/hexmora/flowdown/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmora/flowdown.git",
    "directory": "packages/preset-plugins"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flowdown/types": "workspace:*",
    "@flowdown/utils": "workspace:*",
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "@types/unist": "catalog:",
    "hast-util-sanitize": "catalog:",
    "lodash-es": "catalog:",
    "mdast-util-from-markdown": "catalog:",
    "mdast-util-gfm-autolink-literal": "catalog:",
    "mdast-util-gfm-footnote": "catalog:",
    "mdast-util-gfm-strikethrough": "catalog:",
    "mdast-util-gfm-table": "catalog:",
    "mdast-util-gfm-task-list-item": "catalog:",
    "mdast-util-math": "catalog:",
    "mdast-util-to-markdown": "catalog:",
    "micromark-extension-gfm-autolink-literal": "catalog:",
    "micromark-extension-gfm-footnote": "catalog:",
    "micromark-extension-gfm-strikethrough": "catalog:",
    "micromark-extension-gfm-table": "catalog:",
    "micromark-extension-gfm-task-list-item": "catalog:",
    "micromark-extension-math": "catalog:",
    "micromark-util-character": "catalog:",
    "micromark-util-types": "catalog:",
    "rehype-raw": "catalog:",
    "rehype-sanitize": "catalog:",
    "remark-breaks": "catalog:",
    "unified": "catalog:"
  },
  "devDependencies": {
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "remark-parse": "catalog:",
    "remark-rehype": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
