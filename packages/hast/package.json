{
  "name": "@fluxdown/hast",
  "version": "0.5.1",
  "description": "HTML AST content helpers for Fluxdown packages.",
  "keywords": [
    "hast",
    "llm",
    "markdown",
    "streaming"
  ],
  "homepage": "https://github.com/hexmora/fluxdown/tree/main/packages/hast#readme",
  "bugs": {
    "url": "https://github.com/hexmora/fluxdown/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmora/fluxdown.git",
    "directory": "packages/hast"
  },
  "files": [
    "dist/esm",
    "dist/cjs",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/cjs/index.cjs",
    "module": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.cts",
          "default": "./dist/cjs/index.cjs"
        }
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "lint": "oxlint .",
    "test": "jest --config ../../jest.config.ts --selectProjects hast --runInBand",
    "typecheck": "tsc --noEmit",
    "prepack": "tsx ../../scripts/check-package.ts --source"
  },
  "dependencies": {
    "@types/hast": "catalog:",
    "lodash-es": "catalog:"
  },
  "devDependencies": {
    "@rslib/core": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
