{
  "name": "@fluxdown/core-presets",
  "version": "1.0.0",
  "description": "Headless preset mapper, remark, rehype, and repair plugins for Fluxdown.",
  "keywords": [
    "headless",
    "markdown",
    "plugins",
    "rehype",
    "remark",
    "unified"
  ],
  "homepage": "https://github.com/hexmora/flowdown/tree/main/packages/core-presets#readme",
  "bugs": {
    "url": "https://github.com/hexmora/flowdown/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmora/flowdown.git",
    "directory": "packages/core-presets"
  },
  "files": [
    "dist/esm",
    "dist/cjs",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./mapper": "./src/mapper/index.ts",
    "./rehype": "./src/rehype/index.ts",
    "./remark": "./src/remark/index.ts",
    "./repair": "./src/repair/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./mapper": {
        "import": {
          "types": "./dist/esm/mapper/index.d.ts",
          "default": "./dist/esm/mapper.js"
        },
        "require": {
          "types": "./dist/cjs/mapper/index.d.cts",
          "default": "./dist/cjs/mapper.cjs"
        }
      },
      "./rehype": {
        "import": {
          "types": "./dist/esm/rehype/index.d.ts",
          "default": "./dist/esm/rehype.js"
        },
        "require": {
          "types": "./dist/cjs/rehype/index.d.cts",
          "default": "./dist/cjs/rehype.cjs"
        }
      },
      "./remark": {
        "import": {
          "types": "./dist/esm/remark/index.d.ts",
          "default": "./dist/esm/remark.js"
        },
        "require": {
          "types": "./dist/cjs/remark/index.d.cts",
          "default": "./dist/cjs/remark.cjs"
        }
      },
      "./repair": {
        "import": {
          "types": "./dist/esm/repair/index.d.ts",
          "default": "./dist/esm/repair.js"
        },
        "require": {
          "types": "./dist/cjs/repair/index.d.cts",
          "default": "./dist/cjs/repair.cjs"
        }
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "lint": "oxlint .",
    "test": "jest --config ../../jest.config.ts --selectProjects core-presets --runInBand",
    "typecheck": "tsc --noEmit",
    "prepack": "tsx ../../scripts/check-package.ts --source"
  },
  "dependencies": {
    "@fluxdown/types": "workspace:*",
    "@fluxdown/utils": "workspace:*",
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "@types/unist": "catalog:",
    "functive": "workspace:*",
    "hast-util-sanitize": "catalog:",
    "lodash-es": "catalog:",
    "mdast-util-from-markdown": "catalog:",
    "mdast-util-gfm-autolink-literal": "catalog:",
    "mdast-util-gfm-footnote": "catalog:",
    "mdast-util-gfm-strikethrough": "catalog:",
    "mdast-util-gfm-table": "catalog:",
    "mdast-util-gfm-task-list-item": "catalog:",
    "mdast-util-math": "catalog:",
    "mdast-util-to-markdown": "catalog:",
    "micromark-extension-gfm-autolink-literal": "catalog:",
    "micromark-extension-gfm-footnote": "catalog:",
    "micromark-extension-gfm-strikethrough": "catalog:",
    "micromark-extension-gfm-table": "catalog:",
    "micromark-extension-gfm-task-list-item": "catalog:",
    "micromark-extension-math": "catalog:",
    "micromark-util-character": "catalog:",
    "micromark-util-types": "catalog:",
    "rehype-raw": "catalog:",
    "rehype-sanitize": "catalog:",
    "remark-breaks": "catalog:",
    "rxjs": "catalog:",
    "shallow-equal": "catalog:",
    "unified": "catalog:"
  },
  "devDependencies": {
    "@rslib/core": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "expect-type": "catalog:",
    "oxlint": "catalog:",
    "remark-parse": "catalog:",
    "remark-rehype": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
