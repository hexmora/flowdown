{
  "name": "@flowdown/core",
  "version": "0.1.0",
  "description": "Headless pure-computation utilities for turning streaming Markdown strings into HAST structures.",
  "keywords": [
    "hast",
    "headless",
    "llm",
    "markdown",
    "streaming",
    "unified"
  ],
  "homepage": "https://github.com/hexmora/flowdown/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/hexmora/flowdown/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmora/flowdown.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flowdown/core-presets": "workspace:*",
    "@flowdown/types": "workspace:*",
    "@flowdown/utils": "workspace:*",
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "lodash-es": "catalog:",
    "marked": "catalog:",
    "reactive": "workspace:*",
    "remark-parse": "catalog:",
    "remark-rehype": "catalog:",
    "rxjs": "catalog:",
    "shallow-equal": "catalog:",
    "unified": "catalog:"
  },
  "devDependencies": {
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "mdast-util-gfm-table": "catalog:",
    "micromark-extension-gfm-table": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
