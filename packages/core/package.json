{
  "name": "@fluxdown/core",
  "version": "1.0.0",
  "description": "Headless pure-computation utilities for turning streaming Markdown strings into HAST structures.",
  "keywords": [
    "hast",
    "headless",
    "llm",
    "markdown",
    "streaming",
    "unified"
  ],
  "homepage": "https://github.com/hexmora/flowdown/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/hexmora/flowdown/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmora/flowdown.git",
    "directory": "packages/core"
  },
  "files": [
    "dist/esm",
    "dist/cjs",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/cjs/index.cjs",
    "module": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.cts",
          "default": "./dist/cjs/index.cjs"
        }
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "lint": "oxlint .",
    "test": "jest --config ../../jest.config.ts --selectProjects core --runInBand",
    "typecheck": "tsc --noEmit",
    "prepack": "tsx ../../scripts/check-package.ts --source"
  },
  "dependencies": {
    "@fluxdown/core-presets": "workspace:*",
    "@fluxdown/types": "workspace:*",
    "@fluxdown/utils": "workspace:*",
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "functive": "workspace:*",
    "lodash-es": "catalog:",
    "marked": "catalog:",
    "remark-parse": "catalog:",
    "remark-rehype": "catalog:",
    "rxjs": "catalog:",
    "shallow-equal": "catalog:",
    "unified": "catalog:"
  },
  "devDependencies": {
    "@rslib/core": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "expect-type": "catalog:",
    "mdast-util-gfm-table": "catalog:",
    "micromark-extension-gfm-table": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
