{
  "name": "@flowdown/utils",
  "version": "0.1.0",
  "description": "Shared utility helpers for Flowdown packages.",
  "keywords": [
    "llm",
    "markdown",
    "streaming",
    "utils"
  ],
  "homepage": "https://github.com/hexmora/flowdown/tree/main/packages/utils#readme",
  "bugs": {
    "url": "https://github.com/hexmora/flowdown/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmora/flowdown.git",
    "directory": "packages/utils"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "lodash-es": "catalog:"
  },
  "devDependencies": {
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
