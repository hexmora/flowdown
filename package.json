{
  "name": "flowdown",
  "version": "0.1.0",
  "private": true,
  "description": "Extensible, headless-capable, reactive Markdown rendering for LLM streaming scenarios.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmora/flowdown.git"
  },
  "bugs": {
    "url": "https://github.com/hexmora/flowdown/issues"
  },
  "homepage": "https://github.com/hexmora/flowdown#readme",
  "keywords": [
    "markdown",
    "streaming",
    "llm",
    "headless",
    "react",
    "hast"
  ],
  "scripts": {
    "build": "pnpm --filter @flowdown/core build && pnpm --filter @flowdown/react build",
    "build:storybook": "pnpm --filter @flowdown/react build:storybook",
    "dev": "pnpm --filter @flowdown/react dev",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
